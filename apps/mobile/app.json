{
  "expo": {
    "name": "Galaxia",
    "slug": "galaxia",
    "scheme": "galaxia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#191331"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.galaxia.app"
    },
    "android": {
      "package": "com.galaxia.app",
      "adaptiveIcon": {
        "backgroundColor": "#191331"
      }
    },
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "galaxiamea",
    "extra": {
      "eas": {
        "projectId": "2b9a7e31-c55f-4636-92d2-fbcf9e89dbe8"
      },
      "router": {
        "origin": false
      }
    }
  }
}
