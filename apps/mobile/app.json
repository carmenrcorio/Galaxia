{
  "expo": {
    "name": "Galaxia",
    "slug": "galaxia",
    "scheme": "galaxia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.galaxia.app"
    },
    "android": {
      "package": "com.galaxia.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0a0717"
      }
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0717",
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "galaxiamea",
    "extra": {
      "eas": {
        "projectId": "2b9a7e31-c55f-4636-92d2-fbcf9e89dbe8"
      },
      "router": {
        "origin": false
      }
    }
  }
}
